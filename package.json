{
  "name": "opencode-firefox",
  "version": "1.0.1",
  "description": "Firefox extension integrating OpenCode AI agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "web-ext": "npx web-ext run --devtools",
    "lint": "npx web-ext lint",
    "build": "vite build && npx web-ext build --overwrite-dest",
    "build:xpi": "npm run build && cp web-ext-artifacts/opencode-*.zip web-ext-artifacts/opencode.xpi",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.14.0",
    "debug": "^4.4.3",
    "dompurify": "^3.4.2",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/debug": "^4.1.13",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.5",
    "web-ext": "^8.0.0"
  }
}
