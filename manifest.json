{
  "manifest_version": 3,
  "name": "OpenCode",
  "version": "0.1.0",
  "description": "Integrate OpenCode AI agent into your browser",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "opencode@opencode.ai",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:4096/*"
  ],
  "background": {
    "scripts": ["src/background.js"]
  },
  "sidebar_action": {
    "default_title": "OpenCode",
    "default_panel": "src/sidebar/sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/extract.js"],
      "run_at": "document_idle"
    }
  ]
}
