{
  "manifest_version": 3,
  "name": "OpenCode",
  "version": "1.1.1",
  "description": "Integrate OpenCode AI agent into your browser",
  "icons": {
    "12": "icons/opencode-logo-dark-square-12.png",
    "32": "icons/opencode-logo-dark-square-32.png",
    "48": "icons/opencode-logo-dark-square-48.png",
    "64": "icons/opencode-logo-dark-square-64.png",
    "128": "icons/opencode-logo-dark-square-128.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:4096/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "12": "icons/opencode-logo-dark-square-12.png",
      "32": "icons/opencode-logo-dark-square-32.png",
      "48": "icons/opencode-logo-dark-square-48.png",
      "64": "icons/opencode-logo-dark-square-64.png",
      "128": "icons/opencode-logo-dark-square-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/extract.js"],
      "run_at": "document_idle"
    }
  ]
}
